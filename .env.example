# Local development settings. Copy to .env to override the defaults in docker-compose.yml.
# .env is git-ignored; never commit real credentials.
POSTGRES_DB=todos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Chainguard Libraries credentials are read from your shell at build time
# (passed as BuildKit secrets, never stored in the image):
#   export CHAINGUARD_PYTHON_IDENTITY_ID=...
#   export CHAINGUARD_PYTHON_TOKEN=...